{ "type": "Feature", "properties": { "element_ty": null, "osmid": null, "Naam": "Speeltuin Nieuwendam", "Adres": "Monnikendammerplantsoen 12a", "Type_speelplek": "Speeltuin", "Toelichting": "SPIN speeltuin is “mee-speelbaar” voor kinderen met een lichamelijke beperking. Alle kinderen kunnen meedoen.\r\n\r\no.a. door (verharde) routes over het terrein, door toegankelijke /bereikbare water- en zandspeelplaatsen, door sportveldjes met hellingen (voor rolstoelen), door speeltoestellen waar ook kinderen met een lichamelijke beperking in kunnen zoals hangmatschommels, of de tweeschommel, of een toestel waar ook een kind met een rolstoel tot op “zekere” hoogte in kan. ", "Foto": "Nieuwendam.png", "Website": "http://www.stichting-spin.nl/speeltuinen/nieuwendam/", "layer": "Playgroundsgeojson_lnglat — TOEGANKELIJK_SPELEN", "path": "C:/Users/Petar Koljensic/Playgroundsgeojson_lnglat.json|layername=TOEGANKELIJK_SPELEN" }, "geometry": { "type": "Point", "coordinates": [ 4.9501484, 52.3893265 ] } },
{ "type": "Feature", "properties": { "element_ty": null, "osmid": null, "Naam": "Speeltuin de Sterspelers", "Adres": "Markengouw 245", "Type_speelplek": "Speeltuin", "Toelichting": "SPIN speeltuin is “mee-speelbaar” voor kinderen met een lichamelijke beperking. Alle kinderen kunnen meedoen.\r\n\r\no.a. door (verharde) routes over het terrein, door toegankelijke /bereikbare water- en zandspeelplaatsen, door sportveldjes met hellingen (voor rolstoelen), door speeltoestellen waar ook kinderen met een lichamelijke beperking in kunnen zoals hangmatschommels, of de tweeschommel, of een toestel waar ook een kind met een rolstoel tot op “zekere” hoogte in kan.\r\n\r\nDe Sterspelers is ook getest door de Speeltuinbende (een groep kinderen met een beperking).", "Foto": "Sterspelers.png", "Website": "https://www.stichting-spin.nl/speeltuinen/sterspelers/", "layer": "Playgroundsgeojson_lnglat — TOEGANKELIJK_SPELEN", "path": "C:/Users/Petar Koljensic/Playgroundsgeojson_lnglat.json|layername=TOEGANKELIJK_SPELEN" }, "geometry": { "type": "Point", "coordinates": [ 4.9589609, 52.3942184 ] } },
